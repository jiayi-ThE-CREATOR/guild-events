# Supabase の Project Settings → API Keys からコピーして、
# このファイルを .env.local という名前でコピーして貼る。
# 2 行そろった時点でアプリは自動的に本番 DB を見にいく（未設定ならモックで動く）。
# 「=」の後にスペースを入れないこと。書き換えたら npm run dev を再起動。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ↓ 日程調整（カレンダー連携）を使うときだけ。サーバー側でしか読まないので NEXT_PUBLIC_ を付けない。
# secret key は Supabase の Project Settings → API Keys の secret（sb_secret_…）。
SUPABASE_SECRET_KEY=
# Google Cloud Console → 認証情報 → OAuth クライアント ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 会議の自動決定。pg_cron の SQL に書く値と同じにする（README「会議の自動決定」）
CRON_SECRET=
